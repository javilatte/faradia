#!/usr/bin/env node
'use strict';

// Fake GitHub CLI for end-to-end tests: logged in, and `gh pr create` / `gh pr edit` print a PR URL.
// Every call (arguments and stdin) is recorded in FAKE_GH_LOG.
const fs = require('fs');

const args = process.argv.slice(2);
const input = args.includes('--body-file') ? fs.readFileSync(0, 'utf8') : '';
if (process.env.FAKE_GH_LOG) fs.appendFileSync(process.env.FAKE_GH_LOG, JSON.stringify({ args, input }) + '\n');
if (args[0] === 'auth') process.exit(0);
if (args[0] === 'pr') {
  console.log('https://github.com/acme/demo/pull/1');
  process.exit(0);
}
process.exit(1);
