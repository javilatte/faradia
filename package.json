{
  "name": "@javilatte/optimia",
  "version": "1.0.1",
  "description": "Local web app for Claude Code and local AI — launches a project dashboard backed by codegraph",
  "license": "MIT",
  "author": "Javier <ai@jagoan.es>",
  "homepage": "https://github.com/javilatte/optimia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javilatte/optimia.git"
  },
  "keywords": [
    "ai",
    "claude",
    "claude-code",
    "local-ai",
    "codegraph",
    "cli",
    "developer-tools"
  ],
  "bin": {
    "optimia": "bin/optimia"
  },
  "files": [
    "bin/optimia",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test 'test/unit/**/*.test.js' && bats test/",
    "test:unit": "node --test 'test/unit/**/*.test.js'",
    "test:bats": "bats test/",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "node --test 'test/unit/**/*.test.js' && bats test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "bats": "^1.11.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
