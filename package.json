{
  "name": "faradia",
  "version": "3.0.0",
  "description": "Faradia (formerly optimia): create quality code by automating your processes. A local web app to direct and supervise coding agents (Claude Code and local AI) across many repos",
  "license": "MIT",
  "author": "Javier <ai@jagoan.es>",
  "homepage": "https://github.com/javilatte/faradia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javilatte/faradia.git"
  },
  "keywords": [
    "ai",
    "claude",
    "claude-code",
    "local-ai",
    "codegraph",
    "cli",
    "developer-tools",
    "agents",
    "workbench",
    "git",
    "monitoring",
    "diff"
  ],
  "bin": {
    "faradia": "bin/faradia"
  },
  "files": [
    "bin/faradia",
    "server",
    "web",
    "vendor"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:unit && bats test/",
    "test:unit": "node --test --import ./test/unit/setup.mjs 'test/unit/**/*.test.js'",
    "test:bats": "bats test/",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:apple-voice": "scripts/build-apple-voice.sh",
    "prepublishOnly": "npm run test:unit && bats test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.1",
    "bats": "^1.11.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
