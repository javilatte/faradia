#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const readline = require('readline');
const { execFileSync, spawnSync } = require('child_process');

const pkg = require('../package.json');
const { adoptLegacyEnv, migrateGlobal, migrateRepo } = require('../server/migrate/rename');

// optimia is now Faradia: OPTIMIA_PORT and the rest still work.
adoptLegacyEnv();

function printHelp() {
  console.log(`faradia v${pkg.version}

Uso:
  faradia                Arranca el servidor web en el directorio actual y abre el navegador.

Opciones:
  -p, --port <n>          Puerto fijo (por defecto, uno libre al azar).
  -V, --version           Muestra la versión.
  -h, --help              Muestra esta ayuda.

Variables de entorno:
  FARADIA_PORT=<n>        Igual que --port.
  FARADIA_NO_OPEN=1       No abre el navegador (p. ej. por SSH): usa el enlace que se imprime.

Toda la configuracion (workbenches, agentes y sus modelos, IA local, instrucciones,
memoria, no-go, skills, avisos y lista de vigilancia) se gestiona desde la
interfaz web (icono de ajustes), no desde la CLI.
`);
}

function isGitRepo(dir) {
  try {
    execFileSync('git', ['rev-parse', '--git-dir'], { cwd: dir, stdio: 'ignore' });
    return true;
  } catch {
    return false;
  }
}

// Excludes paths from git in .git/info/exclude (local, unversioned): faradia never touches the
// repo's .gitignore, which belongs to the project and the team.
function excludeFromGit(dir, entries) {
  let gitDir;
  try {
    gitDir = execFileSync('git', ['rev-parse', '--git-common-dir'], { cwd: dir, encoding: 'utf8' }).trim();
  } catch {
    return;
  }
  const exclude = path.join(path.resolve(dir, gitDir), 'info', 'exclude');
  let content = fs.existsSync(exclude) ? fs.readFileSync(exclude, 'utf8') : '';
  let changed = false;
  for (const entry of entries) {
    const pattern = new RegExp(`^/?${entry.replace(/^\//, '').replace(/\./g, '\\.')}/?$`, 'm');
    if (pattern.test(content)) continue;
    if (content.length && !content.endsWith('\n')) content += '\n';
    content += `${entry}\n`;
    changed = true;
  }
  if (!changed) return;
  fs.mkdirSync(path.dirname(exclude), { recursive: true });
  fs.writeFileSync(exclude, content);
}

// Creates .faradia/ (faradia's local state, excluded from git).
function ensureProjectDir(dir) {
  fs.mkdirSync(path.join(dir, '.faradia'), { recursive: true });
  if (isGitRepo(dir)) excludeFromGit(dir, ['/.faradia']);
}

// CodeGraph expects its database in <repo>/.codegraph: it is linked to .faradia/.codegraph only
// when the user enables CodeGraph.
function ensureCodegraphLink(dir) {
  const codegraphLink = path.join(dir, '.codegraph');
  const codegraphReal = path.join(dir, '.faradia', '.codegraph');
  fs.mkdirSync(codegraphReal, { recursive: true });
  // A link left pointing elsewhere (the old .optimia/.codegraph) is made again.
  let current = null;
  try {
    current = fs.lstatSync(codegraphLink).isSymbolicLink() ? fs.readlinkSync(codegraphLink) : 'not a link';
  } catch {
    /* no link yet */
  }
  if (current !== null && current !== 'not a link' && path.resolve(dir, current) !== codegraphReal) {
    fs.unlinkSync(codegraphLink);
    current = null;
  }
  if (current === null) fs.symlinkSync(codegraphReal, codegraphLink);
  excludeFromGit(dir, ['/.codegraph']);
}

function askYesNo(question, defaultYes) {
  if (!process.stdin.isTTY) return Promise.resolve(defaultYes);
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  const suffix = defaultYes ? '[S/n]' : '[s/N]';
  return new Promise((resolve) => {
    rl.question(`${question} ${suffix} `, (answer) => {
      rl.close();
      const a = answer.trim().toLowerCase();
      if (!a) return resolve(defaultYes);
      resolve(a === 's' || a === 'si' || a === 'y' || a === 'yes');
    });
  });
}

function codegraphStatePath(dir) {
  return path.join(dir, '.faradia', 'codegraph.json');
}

function loadCodegraphState(dir) {
  const file = codegraphStatePath(dir);
  if (!fs.existsSync(file)) return null;
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return null;
  }
}

function saveCodegraphState(dir, state) {
  fs.writeFileSync(codegraphStatePath(dir), JSON.stringify(state, null, 2) + '\n');
}

// Trimmed-down version of the old handle_codegraph: ask once whether to enable
// CodeGraph for this repo, then offer to init/sync on each launch. State lives
// in .faradia/codegraph.json instead of the old ~/.config/faradia/repos/*.conf
// registry, since all per-project state now lives under .faradia/.
async function setupCodegraph(dir) {
  if (!isGitRepo(dir)) return;

  let state = loadCodegraphState(dir);
  if (!state) {
    const enabled = await askYesNo('\n¿Activar CodeGraph (indice de codigo para la IA)?', false);
    state = { enabled, initialized: false };
    saveCodegraphState(dir, state);
  }
  if (!state.enabled) return;
  ensureCodegraphLink(dir);

  const cgArgs = ['@colbymchenry/codegraph'];
  if (!state.initialized) {
    const doInit = await askYesNo('CodeGraph no esta inicializado. ¿Inicializarlo ahora?', true);
    if (doInit) {
      console.log('Construyendo indice de codigo...');
      spawnSync('npx', [...cgArgs, 'init', '-i'], { cwd: dir, stdio: 'inherit' });
      state.initialized = true;
      saveCodegraphState(dir, state);
      console.log('CodeGraph inicializado.');
    }
  } else {
    const doSync = await askYesNo('¿Sincronizar CodeGraph? (actualizar indice con cambios recientes)', false);
    if (doSync) {
      console.log('Sincronizando indice de codigo...');
      spawnSync('npx', [...cgArgs, 'sync'], { cwd: dir, stdio: 'inherit' });
      console.log('CodeGraph sincronizado.');
    }
  }
}

function parsePort(value) {
  if (value === undefined || value === '') return 0;
  const port = Number(value);
  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    throw new Error(`puerto no válido: ${value} (usa un número entre 1 y 65535)`);
  }
  return port;
}

async function main() {
  const args = process.argv.slice(2);
  const arg = args[0];
  if (arg === '--version' || arg === '-V') {
    console.log(`faradia ${pkg.version}`);
    return;
  }
  if (arg === '--help' || arg === '-h') {
    printHelp();
    return;
  }

  const portFlag = args.findIndex((a) => a === '--port' || a === '-p');
  const inline = args.find((a) => a.startsWith('--port='));
  const port = parsePort(
    inline ? inline.slice('--port='.length) : portFlag >= 0 ? args[portFlag + 1] : process.env.FARADIA_PORT
  );
  const known = new Set(['--port', '-p']);
  const unknown = args.find(
    (a, i) => !known.has(a) && !a.startsWith('--port=') && !(portFlag >= 0 && i === portFlag + 1)
  );
  if (unknown) throw new Error(`opción desconocida: ${unknown} (faradia --help)`);

  const projectRoot = process.cwd();
  // optimia is now Faradia: its folders are moved before anything creates the new ones.
  for (const [from, to] of migrateGlobal()) console.log(`Faradia: ${from} se ha movido a ${to}`);
  if (migrateRepo(projectRoot)) console.log(`Faradia: ${projectRoot}/.optimia se ha movido a .faradia`);
  ensureProjectDir(projectRoot);
  await setupCodegraph(projectRoot);

  const { start } = require('../server/index.js');
  // FARADIA_NO_OPEN=1: do not open the browser (tests, remote servers over SSH).
  await start({ projectRoot, port, open: !process.env.FARADIA_NO_OPEN });
}

main().catch((err) => {
  console.error(err && err.message ? err.message : err);
  process.exit(1);
});
